# Copy to .env.local for local development. Production values live in the
# Netlify environment variable settings, not in this repo.

# --- NASA -------------------------------------------------------------------
# Free key from https://api.nasa.gov/. Defaults to DEMO_KEY (rate-limited).
NASA_API_KEY=DEMO_KEY

# --- Site -------------------------------------------------------------------
# Apex host, no www. Used for canonical URLs, Stripe redirect URLs and the
# magic-link URLs in outgoing email.
NEXT_PUBLIC_SITE_URL=https://portalastra.com

# --- Anthropic --------------------------------------------------------------
# Powers the simplified APOD text, ritual prompts and the email generators.
ANTHROPIC_API_KEY=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- MailerLite -------------------------------------------------------------
MAILERLITE_API_KEY=
# Optional. Defaults to the shared FREE_GROUP_ID constant when unset.
MAILERLITE_GROUP_ID=

# --- Supabase ---------------------------------------------------------------
# Service key, server-side only. Backs the Amazon product cache, the generated
# text cache and the magic-link token store.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Resend (premium magic links) -------------------------------------------
# The sending domain must be verified in Resend first. See MAINTENANCE.md.
RESEND_API_KEY=
# Optional override for the From address.
RESEND_FROM=Portal Astra <noreply@portalastra.com>

# --- Premium entitlement ----------------------------------------------------
# HMAC key for the signed 24-hour entitlement cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this immediately signs every visitor out of premium, which is the
# intended emergency lever.
PREMIUM_TOKEN_SECRET=

# --- Amazon Associates ------------------------------------------------------
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_ASSOCIATE_TAG=blasdigital-22
